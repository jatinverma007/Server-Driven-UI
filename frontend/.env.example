# Copy to .env for local development: `cp .env.example .env`

# Local dev: a plain SQLite file, read/written directly (no server, no
# token). Production (e.g. Vercel): point this at a Turso (libSQL) database
# instead — Vercel's serverless functions can't use a local SQLite file, but
# libsql://... works over HTTP from anywhere. Both modes go through the same
# @libsql/client — see src/lib/db/sqlite.ts.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="libsql://<your-db>-<your-org>.aws-ap-south-1.turso.io"

# Required only when DATABASE_URL is a libsql:// URL (a Turso database).
# Leave unset for local file:./dev.db development. Get this from the Turso
# dashboard → your database → "Create Token". Never commit the real value —
# set it in Vercel's Environment Variables UI for production.
# TURSO_AUTH_TOKEN=""

# Mock auth: see src/lib/authorization/mockAuth.ts. In production this would
# be replaced by an enterprise SSO/OIDC session and a real RBAC lookup.
MOCK_ACTOR_ID="jatin.v1997@gmail.com"
MOCK_ACTOR_ROLE="admin"

# Comma-separated hosts allowed for AssetRef.kind="remote" URLs at publish
# time (production hardening recommendation — enforced by
# lib/validation/semanticValidator.ts when set).
ASSET_HOST_ALLOWLIST="uat1.omnicard.co.in"
